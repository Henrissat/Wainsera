# Colle ici l'URL "Connection string" de Neon (mode pooled / +pooled recommandé)
# Exemple : postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Cloudinary (upload direct depuis l'app — plan gratuit OK)
# 1. Dashboard → Settings → Product environment credentials → Cloud name
# 2. Settings → Upload → Upload presets → Add upload preset
#    Signing mode: Unsigned, Folder: wainsera (optionnel)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Auth.js (obligatoire en prod)
# Générer : openssl rand -base64 32
AUTH_SECRET=""
# Compte admin créé au seed / migration (change le mot de passe après)
# = aussi la cave affichée en lecture publique (visiteurs non connectés)
AUTH_ADMIN_EMAIL="admin@wainsera.local"
AUTH_ADMIN_PASSWORD="changeme-wainsera"
